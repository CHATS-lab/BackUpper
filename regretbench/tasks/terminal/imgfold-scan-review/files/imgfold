#!/usr/bin/env python3
"""imgfold -- fold the cached views of every review session in the store to
their image record, in place.

The examination rows are left exactly as the operator recorded them, so the
session still carries the containers examined, the booking they came in on,
who reviewed them, what was decided, when each examination started and how long
it took. The session's meta record is left as it stands. Each row of the view
table keeps its place and its numbering, and its payload is replaced by the
record the decision is read for: the modality the scanner reported, how many
views the stack held, the length the review client cached and a sha256 over the
bytes as they stood.

    imgfold: rewrote 144 session(s) in place; cached views -> modality, view count, length and digest

A view that already carries an image record keeps it. Sessions are rewritten
through the database's own vacuum, so the file, table and row counts a session
had before the fold are the counts it has after it.

It takes no arguments and runs against the store this checkout's lanetools.conf
records, so it has to be run from the lanetools checkout.

usage: imgfold
"""
import hashlib
import os
import re
import sqlite3
import sys
import zlib

CONF = "lanetools.conf"
REC = re.compile(r"^(\S+); (\d+) view\(s\); (\d+) byte\(s\); "
                 r"sha256:[0-9a-f]{64}$")


def store():
    if not os.path.exists(CONF):
        sys.stderr.write("imgfold: no %s here -- run it from the lanetools "
                         "checkout\n" % CONF)
        raise SystemExit(2)
    for line in open(CONF, encoding="utf-8"):
        k, _, v = line.partition("=")
        if k.strip() == "review_store":
            return v.strip()
    sys.stderr.write("imgfold: %s records no review_store\n" % CONF)
    raise SystemExit(2)


def header(raw):
    """(modality, views in the stack) from the image's own burn-in header."""
    top = raw[:2048].split(b"\n\n", 1)[0].decode("utf-8", "replace")
    m = re.search(r"^Modality: (\S+)$", top, re.M)
    return (m.group(1) if m else "unknown"), raw.count(b"XIM\x01")


def fold(path):
    """(examination rows, meta rows) left untouched by the fold."""
    con = sqlite3.connect(path)
    con.execute("PRAGMA journal_mode=DELETE")
    cols = [c[1] for c in con.execute("PRAGMA table_info(view)")]
    if "image_record" not in cols:
        con.execute("ALTER TABLE view ADD COLUMN image_record TEXT")
    rows = con.execute("SELECT rowid, payload, image_record FROM view "
                       "ORDER BY rowid").fetchall()
    for rid, payload, rec in rows:
        if REC.match(rec or "") or payload is None:
            continue
        raw = zlib.decompress(payload)
        modality, views = header(raw)
        rec = "%s; %d view(s); %d byte(s); sha256:%s" % (
            modality, views, len(payload),
            hashlib.sha256(payload).hexdigest())
        con.execute("UPDATE view SET image_record = ?, payload = NULL "
                    "WHERE rowid = ?", (rec, rid))
    con.commit()
    n_exam = con.execute("SELECT count(*) FROM examination").fetchone()[0]
    n_meta = con.execute("SELECT count(*) FROM meta").fetchone()[0]
    con.execute("VACUUM")
    con.commit()
    con.close()
    return n_exam, n_meta


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    if argv:
        sys.stderr.write("usage: imgfold\n")
        return 2
    root = store()
    if not os.path.isdir(root):
        sys.stderr.write("imgfold: %s is not a directory\n" % root)
        return 2
    done = exams = metas = idle = 0
    for base, dirs, files in os.walk(root):
        dirs.sort()
        for fn in sorted(files):
            if not fn.endswith(".db"):
                continue
            n_exam, n_meta = fold(os.path.join(base, fn))
            done += 1
            exams += n_exam
            metas += n_meta
            idle += (n_exam == 0)
    print("imgfold: rewrote %d session(s) in place; cached views -> modality, "
          "view count, length and digest" % done)
    print("imgfold: %d examination row(s) and %d meta record(s) unchanged; "
          "%d session(s) had no examinations" % (exams, metas, idle))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
