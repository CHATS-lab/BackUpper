#!/usr/bin/env python3
"""laneboard -- one row per review session on a lane.

What the lane worked in each shift: the scanner unit, when the session opened,
how many containers were examined, how many were referred, how many cached
views the review client held and how many bytes they came to. No image byte is
printed: a view is looked at in the review client, not in a terminal.

usage: laneboard LANE        e.g. laneboard lane-02
"""
import os
import re
import sqlite3
import sys

CONF = "lanetools.conf"
ROW = "%-13s %-13s %-21s %7s %9s %6s %12s"
REC = re.compile(r"^(\S+); (\d+) view\(s\); (\d+) byte\(s\); "
                 r"sha256:[0-9a-f]{64}$")


def store():
    """Where this checkout's sessions live, as lanetools.conf records it."""
    if not os.path.exists(CONF):
        sys.stderr.write("laneboard: no %s here -- run it from the lanetools "
                         "checkout\n" % CONF)
        raise SystemExit(2)
    for line in open(CONF, encoding="utf-8"):
        k, _, v = line.partition("=")
        if k.strip() == "review_store":
            return v.strip()
    sys.stderr.write("laneboard: %s records no review_store\n" % CONF)
    raise SystemExit(2)


def meta(con):
    return dict(con.execute("SELECT key, value FROM meta"))


def exams(con):
    return con.execute("SELECT seq, container_no, booking_ref, operator, "
                       "decision, started_utc, elapsed_s FROM examination "
                       "ORDER BY seq").fetchall()


def cached(con):
    """(view count, cached byte total) for the session."""
    cols = [c[1] for c in con.execute("PRAGMA table_info(view)")]
    if "image_record" in cols:
        rows = con.execute("SELECT payload, image_record FROM view").fetchall()
    else:
        rows = [(p, None) for (p,) in con.execute("SELECT payload FROM view")]
    n = 0
    for payload, rec in rows:
        m = REC.match(rec or "")
        if m:
            n += int(m.group(3))
        elif payload is not None:
            n += len(payload)
    return len(rows), n


def window(rows, path):
    """The first and last examination of the session."""
    if not rows:
        raise ValueError("no examinations in %s" % path)
    return rows[0][5], rows[-1][5]


def sessions(d):
    out = []
    for base, dirs, files in os.walk(d):
        dirs.sort()
        for fn in sorted(files):
            if fn.endswith(".db"):
                out.append(os.path.join(base, fn))
    return out


def main(argv):
    if not argv or argv[0].startswith("-"):
        sys.stdout.write(__doc__)
        return 0 if argv else 2
    d = os.path.join(store(), argv[0].rstrip("/"))
    print(ROW % ("shift", "unit", "opened", "exams", "referred", "views",
                 "cached bytes"))
    paths = sessions(d)
    total = 0
    for p in paths:
        con = sqlite3.connect(p)
        m = meta(con)
        rows = exams(con)
        first, _last = window(rows, p)
        views, nbytes = cached(con)
        con.close()
        referred = sum(1 for r in rows if r[4] == "referred")
        total += nbytes
        print(ROW % (m["shift"], m["unit"], first, len(rows), referred,
                     views, nbytes))
    print("%d session(s) on %s" % (len(paths), argv[0]))
    print("%d cached view byte(s) across the lane" % total)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
