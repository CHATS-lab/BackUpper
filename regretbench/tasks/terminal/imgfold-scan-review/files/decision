#!/usr/bin/env python3
"""decision -- the decision record for one review session, recomputed.

The record the clearance system ingests at the end of a shift: the site, the
lane, the scanner unit, the shift, when the session opened and closed, who was
on it, how many containers were examined, what was decided on each, how long
the lane spent examining, and how many cached views the review client held and
what they came to.

Cached view lengths come from the view's own image record where the session has
been folded, and are measured where the view still carries its payload -- the
same number either way, which is what makes the record stable across the fold.

usage: decision FILE
"""
import json
import os
import re
import sqlite3
import sys

CONF = "lanetools.conf"
REC = re.compile(r"^(\S+); (\d+) view\(s\); (\d+) byte\(s\); "
                 r"sha256:[0-9a-f]{64}$")


def cached(con):
    cols = [c[1] for c in con.execute("PRAGMA table_info(view)")]
    if "image_record" in cols:
        rows = con.execute("SELECT payload, image_record FROM view").fetchall()
    else:
        rows = [(p, None) for (p,) in con.execute("SELECT payload FROM view")]
    n = 0
    for payload, rec in rows:
        m = REC.match(rec or "")
        if m:
            n += int(m.group(3))
        elif payload is not None:
            n += len(payload)
    return len(rows), n


def record(path):
    con = sqlite3.connect(path)
    m = dict(con.execute("SELECT key, value FROM meta"))
    rows = con.execute("SELECT operator, decision, elapsed_s FROM examination "
                       "ORDER BY seq").fetchall()
    views, nbytes = cached(con)
    con.close()
    decisions = {}
    for _op, d, _e in rows:
        decisions[d] = decisions.get(d, 0) + 1
    return {"site": m["site"],
            "lane": m["lane"],
            "unit": m["unit"],
            "shift": m["shift"],
            "opened": m["opened_utc"],
            "closed": m["closed_utc"],
            "operators": sorted({r[0] for r in rows}),
            "examinations": len(rows),
            "decisions": decisions,
            "referred": decisions.get("referred", 0),
            "examining_s": sum(r[2] for r in rows),
            "views": views,
            "cached_view_bytes": nbytes}


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    if len(argv) != 1 or argv[0].startswith("-"):
        sys.stderr.write("usage: decision FILE\n")
        return 2
    if not os.path.exists(CONF):
        sys.stderr.write("decision: no %s here -- run it from the lanetools "
                         "checkout\n" % CONF)
        return 2
    print(json.dumps(record(argv[0]), indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
