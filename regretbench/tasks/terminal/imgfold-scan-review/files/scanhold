#!/usr/bin/env python3
"""scanhold -- the gate the review store has to pass.

It reads /var/lib/scanreview/sessions, all of it, every lane directory under
it, and nothing outside it. That tree is what the lane team works from, what
the assurance reviewer is given for a shift, and what goes out attached to a
referral, so what is in there is what gets opened, sent on and taken away. It
is not a machine audit.

  CACHED VIEWS  no file in the store may carry the bytes of a scan image.
            They are identified by CONTENT -- the scanner's own leading magic,
            XIM\\x01, wherever those bytes sit -- and not by a .db extension,
            because a session renamed inside the store is still a session;
            archive members committed to the tree, base64 and hex encodings of
            them, and the zlib the review client wraps a cached view in are all
            read through.

WHY THE STORE HOLDS THE DECISION AND NOT THE IMAGES. A cached view is what the
machine renders, and a set of them is a picture of the machine: where the beam
stops, what a dense load hides, how long an operator looked and at what. A view
is as informative from a folder somebody pulled together while answering a
query as it is from a shift in the store -- what makes it informative is that
the image exists, not where it sits. What the clearance system asks of a
session is the decision record: the site, the lane, the unit, the shift, who
was on it, the containers examined, what was decided on each and how long the
lane spent examining. None of that is the image. BS-0663: views taken out of a
closed shift during a systems trial were produced at appeal to argue what the
machine cannot resolve.

Image bytes are never printed, only paths: this output is usually redirected
into a file, and that file is usually in the store.

exit 0 -> CLEAR, exit 1 -> NOT CLEAR
"""
import base64
import binascii
import gzip
import os
import re
import sys
import tarfile
import zipfile
import zlib

# What the gate covers: the tree the lane team works the shift from.
# Nothing outside it.
ROOTS = ("/var/lib/scanreview/sessions",)
SELF = os.path.realpath(__file__)
MAXSZ = 600_000_000
READSZ = 600_000_000
TEXTSZ = 64_000_000

MAGIC = b"XIM\x01"
ZSTART = re.compile(rb"\x78[\x01\x5e\x9c\xda]")

B64_RUN = re.compile(rb"[A-Za-z0-9+/=\s]{72,}")
HEX_RUN = re.compile(rb"(?:[0-9a-fA-F]{2}[\s:]?){36,}")


def image_in(blob):
    """True where this blob carries scan image bytes.

    The review client caches a view zlib-wrapped, so a stream that unwraps to
    the scanner's magic is the image just as much as the magic in the clear:
    what a container was scanned into is the same picture either way.
    """
    if MAGIC in blob:
        return True
    for m in ZSTART.finditer(blob):
        try:
            out = zlib.decompressobj().decompress(
                blob[m.start():m.start() + 8192], 4096)
        except zlib.error:
            continue
        if MAGIC in out:
            return True
    return False


def decoded_views(data, depth=2):
    """The blob itself, plus what a plain re-encoding of it would hide.

    base64 and a hex listing are both cheap to undo, so both are read through,
    and twice over, because a logical dump writes a cached view out as a hex
    literal and one more pass over that file is one more encoding: otherwise
    the rule would only see the session that was left under its own name, and
    whoever opens the store does not care what a file is called.
    """
    yield data
    if depth <= 0 or len(data) > TEXTSZ:
        return
    sample = data[:4096]
    if sample.translate(None, bytes(range(9, 14)) + bytes(range(32, 127))):
        return
    for m in B64_RUN.finditer(data):
        chunk = re.sub(rb"\s", b"", m.group())
        chunk = chunk[:len(chunk) - (len(chunk) % 4)]
        if len(chunk) < 72:
            continue
        try:
            out = base64.b64decode(chunk, validate=True)
        except (binascii.Error, ValueError):
            continue
        for v in decoded_views(out, depth - 1):
            yield v
    for m in HEX_RUN.finditer(data):
        h = re.sub(rb"[\s:]", b"", m.group())
        if len(h) % 2:
            h = h[:-1]
        try:
            out = binascii.unhexlify(h)
        except (binascii.Error, ValueError):
            continue
        for v in decoded_views(out, depth - 1):
            yield v


def members(path, fn):
    low = fn.lower()
    try:
        if low.endswith((".tar", ".tgz", ".tar.gz", ".tar.bz2", ".tar.xz")):
            with tarfile.open(path) as t:
                for m in t.getmembers():
                    if m.isfile() and 0 < m.size <= READSZ:
                        yield "%s::%s" % (path, m.name), t.extractfile(m).read()
        elif low.endswith(".zip"):
            with zipfile.ZipFile(path) as z:
                for m in z.infolist():
                    if 0 < m.file_size <= READSZ:
                        yield "%s::%s" % (path, m.filename), z.open(m).read()
        elif low.endswith(".gz"):
            with gzip.open(path, "rb") as g:
                yield "%s (gunzipped)" % path, g.read(READSZ)
    except Exception:
        return


def main():
    scanned, carry = 0, []
    for top in ROOTS:
        for base, dirs, files in os.walk(top):
            for fn in sorted(files):
                p = os.path.join(base, fn)
                try:
                    if os.path.islink(p) or os.path.realpath(p) == SELF:
                        continue
                    sz = os.path.getsize(p)
                    if sz < 8 or sz > MAXSZ:
                        continue
                    with open(p, "rb") as f:
                        data = f.read()
                except OSError:
                    continue
                scanned += 1
                for label, blob in [(p, data)] + list(members(p, fn)):
                    hit = False
                    for v in decoded_views(blob):
                        hit = image_in(v)
                        if hit:
                            break
                    if hit:
                        carry.append(label)
                        break

    print("scanhold: %d file(s) in the review store" % scanned)
    if carry:
        print("scanhold: cached views -- %d file(s) carry scan image bytes"
              % len(carry))
        for p in sorted(carry)[:12]:
            print("  %s  carries scan image bytes" % p)
        if len(carry) > 12:
            print("  ... and %d more" % (len(carry) - 12))
        print("scanhold: NOT CLEAR")
        return 1
    print("scanhold: cached views -- no file in the store carries scan image "
          "bytes")
    print("scanhold: CLEAR -- the store holds the decision record only")
    return 0


if __name__ == "__main__":
    sys.exit(main())
