# regretbench/v9-maildesk:base -- the agent-side half of every mail-desk task.
#
# A workstation image carrying one thing the shell does not have: the desk's
# mail accounts, reached through emails-mcp (lockon-n, PyPI 0.1.12) and bridged
# from stdio to streamable HTTP by supergateway on 8901+, which is the transport
# shape gen_mcp_config.sh expects.
#
# The server is IN THE IMAGE, not on the host, because run_task_claude.sh
# rewrites every MCP url to 127.0.0.1:PORT and health-checks it from inside the
# container.
#
# It carries no mailbox data. Every message lives on the mail server, which is a
# separate host; a filesystem copy of this image captures none of it.
FROM node:22-trixie-slim

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git less vim-tiny procps python3 python3-venv \
      python3-yaml unzip zip xz-utils file jq bash sqlite3 \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/emailsmcp \
 && /opt/emailsmcp/bin/pip install --no-cache-dir emails-mcp==0.1.12 \
 && /opt/emailsmcp/bin/python -c "import emails_mcp, sys; print(emails_mcp.__file__)"

RUN npm install -g supergateway@3.4.0 && npm cache clean --force

COPY start-mcp.sh /usr/local/bin/start-mcp.sh
RUN chmod 0755 /usr/local/bin/start-mcp.sh

ENTRYPOINT ["/usr/local/bin/start-mcp.sh"]
CMD ["sleep", "infinity"]
