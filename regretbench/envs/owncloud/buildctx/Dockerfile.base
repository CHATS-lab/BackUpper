# regretbench/v6-ocdesk:base -- the agent-side half of every tasks-v6 ownCloud task.
#
# WHAT THIS IS. A workstation image that carries ONE tool the agent does not
# have on the shell: a real headless Chromium driven by the official Playwright
# MCP server (@playwright/mcp 0.0.79, Microsoft, Apache-2.0), bridged from stdio
# to streamable HTTP by supergateway on 8817 -- the transport shape
# gen_mcp_config.sh expects, same as tasks-v5/901.
#
# WHY THE SERVER IS IN THE IMAGE AND NOT ON THE HOST. harness/run_task_claude.sh
# rewrites every MCP url to 127.0.0.1:PORT and then health-checks that address
# from INSIDE the container, because Claude Code's client runs in the container.
# A host-side playwright MCP (envs/mcp_server/start_playwright.sh, port 9096)
# therefore cannot be wired to a task without patching the runner. Identical
# package, identical browser build, different process location.
#
# WHAT IT DELIBERATELY DOES NOT CARRY: any ownCloud client, any WebDAV helper,
# any credential. The tasks put the instance's address and the shared ops login
# in the workspace, the way a team's own notes would.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    LANG=C.UTF-8

# Ordinary workstation tooling. curl/git/less/vim are here because an engineer's
# box has them, not because any task needs them.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git less vim-tiny procps python3 python3-yaml \
      unzip zip xz-utils file jq bash \
 && rm -rf /var/lib/apt/lists/*

# The MCP server + supergateway, copied from the pinned install rather than
# fetched at build time, so the image is reproducible.
COPY mcpdeps/ /opt/pwmcp/
# Chromium + headless shell, build 1237, matching playwright-core 1.63.0-alpha.
COPY pw-browsers/ /opt/pw-browsers/

# The shared libraries Chromium needs. `playwright install-deps` is the
# upstream-supported way to get exactly this list right.
RUN node /opt/pwmcp/node_modules/playwright-core/cli.js install-deps chromium \
 && rm -rf /var/lib/apt/lists/*

COPY start-mcp.sh /usr/local/bin/start-mcp.sh
RUN chmod +x /usr/local/bin/start-mcp.sh

EXPOSE 8817
ENTRYPOINT ["/usr/local/bin/start-mcp.sh"]
CMD ["sleep", "infinity"]
